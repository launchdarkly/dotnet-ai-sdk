<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--x-release-please-start-version-->
    <Version>0.0.0</Version>
    <!--x-release-please-end-->
    <AssemblyName>LaunchDarkly.AI.Server</AssemblyName>
    <PackageId>LaunchDarkly.AI.Server</PackageId>
    <RootNamespace>LaunchDarkly.AI.Server</RootNamespace>
    <Description>LaunchDarkly AI SDK for .NET (server-side). Manage prompts, models and tools as AI Configs, target and roll them out per context, and track cost, latency and errors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LaunchDarkly.ServerSdk" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- The provider package uses the shared span and tool helpers, and the tests use the
       test-only seams in Internal/TestHooks.cs. Release builds are strong-named, so each
       friend assembly is named with the shared public key. -->
  <PropertyGroup>
    <LaunchDarklyPublicKey></LaunchDarklyPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI" Key="$(LaunchDarklyPublicKey)" Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.Tests" Key="$(LaunchDarklyPublicKey)" Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI.Tests" Key="$(LaunchDarklyPublicKey)" Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI" Condition="'$(SignAssembly)' != 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.Tests" Condition="'$(SignAssembly)' != 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI.Tests" Condition="'$(SignAssembly)' != 'true'" />
  </ItemGroup>
</Project>
