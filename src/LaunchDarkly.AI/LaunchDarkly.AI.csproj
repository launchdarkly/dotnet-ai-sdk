<Project Sdk="Microsoft.NET.Sdk">
  <!-- Metapackage: no assembly of its own. Referencing LaunchDarkly.AI brings in
       LaunchDarkly.AI.Server, so the types an application uses are the core package's own. -->
  <PropertyGroup>
    <!--x-release-please-start-version-->
    <Version>0.1.0</Version>
    <!--x-release-please-end-->
    <PackageId>LaunchDarkly.AI</PackageId>
    <Description>LaunchDarkly AI SDK for .NET. Convenience package that references LaunchDarkly.AI.Server.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
    <!-- NU5128: a package with dependencies but no lib/ folder is intended here. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchDarkly.AI.Server\LaunchDarkly.AI.Server.csproj" />
  </ItemGroup>
</Project>
