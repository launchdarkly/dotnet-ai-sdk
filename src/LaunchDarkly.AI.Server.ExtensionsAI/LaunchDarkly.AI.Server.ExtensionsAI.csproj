<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--x-release-please-start-version-->
    <Version>0.1.0</Version>
    <!--x-release-please-end-->
    <AssemblyName>LaunchDarkly.AI.Server.ExtensionsAI</AssemblyName>
    <PackageId>LaunchDarkly.AI.Server.ExtensionsAI</PackageId>
    <RootNamespace>LaunchDarkly.AI.Server.ExtensionsAI</RootNamespace>
    <Description>Microsoft.Extensions.AI (IChatClient) provider for the LaunchDarkly AI SDK for .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchDarkly.AI.Server\LaunchDarkly.AI.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <!-- The tests read the package identity constants. Release builds are strong-named, so the
       friend assembly is named with the shared public key. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI.Tests" Key="" Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="LaunchDarkly.AI.Server.ExtensionsAI.Tests" Condition="'$(SignAssembly)' != 'true'" />
  </ItemGroup>
</Project>
